{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./.next/**)",
      "Read(./coverage/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.lock)",
      "Read(./package-lock.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
